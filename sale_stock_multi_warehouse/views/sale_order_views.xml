<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_multi_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.multi.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//form//field[@name='product_uom_id']" position="after">
                <field name="warehouse_stock_info" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='qty_delivered']" position="after">
                <field name="warehouse_stock_info" column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
